{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TalkWeave",
  "version": "0.1.0",
  "identifier": "site.idea2.talkweave",
  "build": {
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": {
      "../../server/": "server/",
      "../../app/dist/": "app/dist/",
      "../../landing/": "landing/"
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
